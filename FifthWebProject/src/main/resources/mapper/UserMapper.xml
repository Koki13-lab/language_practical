<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forgeon.membermanagement.mapper.UserMapper">
	<select id="findByName" resultType="com.forgeon.membermanagement.dto.User">
		SELECT * FROM users WHERE name = #{name}
	</select>
	
	<select id="getUsers" resultType="com.forgeon.membermanagement.dto.User">
		SELECT id,name,role FROM users 
	</select>
	
	<select id="searchUsers" resultType="com.forgeon.membermanagement.dto.User">
		SELECT id, name,role FROM users WHERE name LIKE CONCAT('%', #{uKeyword}, '%')
	</select>
	
	<insert id="insertUser" parameterType="com.forgeon.membermanagement.dto.User">
		INSERT INTO users (name,password,role)
		VALUES(#{name},#{password},#{role})
	</insert>
	
	<delete id="deleteUser" parameterType="int">
		DELETE FROM users
		WHERE id = #{id}
	</delete>
</mapper>