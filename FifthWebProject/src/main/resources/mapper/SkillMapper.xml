<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.forgeon.membermanagement.mapper.SkillMapper">
	<select id="getSkills" resultType="com.forgeon.membermanagement.dto.Skill">
		SELECT s.id,u.name,s.skill FROM skills AS s JOIN users AS u on u.id =
		s.user_id
	</select>
	
	<select id="getMySkills" resultType="com.forgeon.membermanagement.dto.Skill">
		SELECT id,skill FROM skills WHERE user_id = #{id}
	</select>

	<select id="searchSkills"
		resultType="com.forgeon.membermanagement.dto.Skill"> 
		SELECT s.id,u.name,s.skill FROM skills AS s JOIN users AS u on u.id = s.user_id
		WHERE s.skill LIKE CONCAT('%', #{sKeyword}, '%')
		<choose>
			<when test="sort == 'name'">
				ORDER BY u.name ASC
			</when>
			<when test="sort == 'skill'">
				ORDER BY s.skill ASC
			</when>
			<otherwise>
				ORDER BY s.id ASC
			</otherwise>
		</choose>
	</select>
	
	<insert id="insertSkill"
		parameterType="com.forgeon.membermanagement.dto.Skill">
		INSERT INTO skills(user_id,skill)
		VALUES(#{userId},#{skill})
	</insert>
	
	<delete id="deleteUser" parameterType="int">
		DELETE FROM users
		WHERE id = #{id}
	</delete>
	
	<delete id="deleteSkill">
		DELETE FROM skills
		WHERE id = #{id}
	</delete>
	
	<delete id="deleteMySkill">
		DELETE FROM skills
		WHERE id = #{id}
		AND user_id = #{loginUserId}
	</delete>
</mapper>